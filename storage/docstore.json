2b-44b3-9242-7f944e084506", "embedding": null, "metadata": {"file_path": "C:\\Users\\g'y'w'y'w\\medical_rag\\knowledge\\\u667a\u6167\u533b\u7597RAG\u5b9e\u9a8c\u77e5\u8bc6\u5e93_30\u9898\u8986\u76d6\u7248.txt", "file_name": "\u667a\u6167\u533b\u7597RAG\u5b9e\u9a8c\u77e5\u8bc6\u5e93_30\u9898\u8986\u76d6\u7248.txt", "file_type": "text/plain", "file_size": 11542, "creation_date": "2026-10-08", "last_modified_date": "2026-10-08"}, "excluded_embed_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "excluded_llm_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "relationships": {"1": {"node_id": "b219da81-f9c8-4a6f-b991-ef25ba51c59e", "node_type": "4", "metadata": {"file_path": "C:\\Users\\g'y'w'y'w\\medical_rag\\knowledge\\\u667a\u6167\u533b\u7597RAG\u5b9e\u9a8c\u77e5\u8bc6\u5e93_30\u9898\u8986\u76d6\u7248.txt", "file_name": "\u667a\u6167\u533b\u7597RAG\u5b9e\u9a8c\u77e5\u8bc6\u5e93_30\u9898\u8986\u76d6\u7248.txt", "file_type": "text/plain", "file_size": 11542, "creation_date": "2026-10-08", "last_modified_date": "2026-10-08"}, "hash": "134405a4e6aee25d8c17108ec8a4423f161296228fd4f6e511be1e075a16dffb", "class_name": "RelatedNodeInfo"}, "3": {"node_id": "e3c155fd-47cf-4b58-980f-33cfaa77cb75", "node_type": "1", "metadata": {}, "hash": "96b7f159bcd35355bb260db7d4045c88fca5d0142bb044aba90b7a7db85ab51f", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "\u667a\u6167\u533b\u7597RAG\u5b9e\u9a8c\u77e5\u8bc6\u5e93\uff0830\u9898\u8986\u76d6\u7248\uff09\r\n\r\n\u8bf4\u660e\uff1a\r\n\u672c\u77e5\u8bc6\u5e93\u7528\u4e8e\u300a\u667a\u6167\u533b\u7597\u524d\u6cbf\u6280\u672f\u300b\u8bfe\u7a0b\u4e2d\u7684RAG\u7cfb\u7edf\u8f6f\u4ef6\u6d4b\u8bd5\u4e0e\u8bba\u6587\u5b9e\u9a8c\uff0c\u4e0d\u7528\u4e8e\u771f\u5b9e\u533b\u7597\u8bca\u65ad\u3002\r\n\u77e5\u8bc6\u5185\u5bb9\u4f18\u5148\u91c7\u7528WHO\u516c\u5f00\u8d44\u6599\u548c\u4e2d\u56fd\u6743\u5a01\u6307\u5357\u3002\u6bcf\u4e2a\u4e3b\u9898\u4fdd\u7559\u6765\u6e90\u4fe1\u606f\uff0c\u4fbf\u4e8e\u5b9e\u9a8c\u4e2d\u7684\u201c\u53ef\u8ffd\u6eaf\u6027\u201d\u8bc4\u4ef7\u3002\r\n\u5bf9\u4e8e\u8bca\u65ad\u9608\u503c\u3001\u6cbb\u7597\u65b9\u6848\u7b49\u53ef\u80fd\u56e0\u6307\u5357\u7248\u672c\u6216\u4e2a\u4f53\u60c5\u51b5\u800c\u53d8\u5316\u7684\u5185\u5bb9\uff0c\u95ee\u7b54\u7cfb\u7edf\u5e94\u63d0\u793a\u4ee5\u6700\u65b0\u6743\u5a01\u6307\u5357\u548c\u4e13\u4e1a\u4eba\u5458\u8bc4\u4f30\u4e3a\u51c6\u3002\r\n\r\n==============================\r\n\u4e00\u3001\u9ad8\u8840\u538b\r\n==============================\r\n\u6838\u5fc3\u77e5\u8bc6\uff1a\r\n\u9ad8\u8840\u538b\u662f\u8840\u538b\u6301\u7eed\u5347\u9ad8\u7684\u6162\u6027\u75be\u75c5\uff0c\u901a\u5e38\u9700\u8981\u89c4\u8303\u6d4b\u91cf\u548c\u4e34\u5e8a\u8bc4\u4f30\u540e\u5224\u65ad\u3002\u8840\u538b\u5305\u62ec\u6536\u7f29\u538b\u548c\u8212\u5f20\u538b\uff1a\u6536\u7f29\u538b\u8868\u793a\u5fc3\u810f\u6536\u7f29\u65f6\u7684\u538b\u529b\uff0c\u8212\u5f20\u538b\u8868\u793a\u5fc3\u810f\u8212\u5f20\u95f4\u671f\u7684\u538b\u529b\u3002\r\n\u5e38\u89c1\u5371\u9669\u56e0\u7d20\u5305\u62ec\u5e74\u9f84\u589e\u957f\u3001\u9057\u4f20/\u5bb6\u65cf\u53f2\u3001\u8d85\u91cd\u6216\u80a5\u80d6\u3001\u9ad8\u76d0\u996e\u98df\u3001\u8eab\u4f53\u6d3b\u52a8\u4e0d\u8db3\u3001\u5438\u70df\u3001\u8fc7\u91cf\u996e\u9152\u7b49\u3002\r\n\u5065\u5eb7\u7ba1\u7406\u5305\u62ec\u5065\u5eb7\u996e\u98df\u3001\u63a7\u5236\u76d0\u6444\u5165\u3001\u4fdd\u6301\u8eab\u4f53\u6d3b\u52a8\u3001\u4f53\u91cd\u7ba1\u7406\u3001\u6212\u70df\u3001\u5408\u7406\u9650\u5236\u996e\u9152\u3001\u8840\u538b\u76d1\u6d4b\u4ee5\u53ca\u5fc5\u8981\u65f6\u6309\u4e13\u4e1a\u4eba\u5458\u5efa\u8bae\u63a5\u53d7\u836f\u7269\u6cbb\u7597\u3002\r\n\u4e0d\u80fd\u56e0\u4e3a\u67d0\u4e00\u6b21\u8840\u538b\u6b63\u5e38\u5c31\u81ea\u884c\u505c\u836f\u6216\u6539\u53d8\u6cbb\u7597\u65b9\u6848\u3002\r\n\u9ad8\u8840\u538b\u957f\u671f\u63a7\u5236\u4e0d\u4f73\u4f1a\u589e\u52a0\u5fc3\u810f\u3001\u8111\u548c\u80be\u810f\u7b49\u5668\u5b98\u635f\u5bb3\u98ce\u9669\u3002\r\n\r\n\u6765\u6e90\uff1a\r\n1. World Health Organization. Hypertension. 2025-09-25.\r\n2. \u4e2d\u56fd\u9ad8\u8840\u538b\u9632\u6cbb\u6307\u5357\u4fee\u8ba2\u59d4\u5458\u4f1a\u7b49. \u4e2d\u56fd\u9ad8\u8840\u538b\u9632\u6cbb\u6307\u5357\uff082024\u5e74\u4fee\u8ba2\u7248\uff09. \u4e2d\u534e\u9ad8\u8840\u538b\u6742\u5fd7\uff08\u4e2d\u82f1\u6587\uff09, 2024, 32(07):603-700. DOI:10.16439/j.issn.1673-7245.2024.07.002.", "mimetype": "text/plain", "start_char_idx": 0, "end_char_idx": 691, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "e3c155fd-47cf-4b58-980f-33cfaa77cb75": {"__data__": {"id_": "e3c155fd-47cf-4b58-980f-33cfaa77cb75", "embedding": null, "metadata": {"file_path": "C:\\Users\\g'y'w'y'w\\medical_rag\\knowledge\\\u667a\u6167\u533b\u7597RAG\u5b9e\u9a8c\u77e5\u8bc6\u5e93_30\u9898\u8986\u76d6\u7248.txt", "file_name": "\u667a\u6167\u533b\u7597RAG\u5b9e\u9a8c\u77e5\u8bc6\u5e93_30\u9898\u8986\u76d6\u7248.txt", "file_type": "text/plain", "file_size": 11542, "creation_date": "2026-10-08", "last_modified_date": "2026-10-08"}, "excluded_embed_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "excluded_llm_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "relationships": {"1": {"node_id": "b219da81-f9c8-4a6f-b991-ef25ba51c59e", "node_type": "4", "metadata": {"file_path": "C:\\Users\\g'y'w'y'w\\medical_rag\\knowledge\\\u667a\u6167\u533b\u7597RAG\u5b9e\u9a8c\u77e5\u8bc6\u5e93_30\u9898\u8986\u76d6\u7248.txt", "file_name": "\u667a\u6167\u533b\u7597RAG\u5b9e\u9a8c\u77e5\u8bc6\u5e93_30\u9898\u8986\u76d6\u7248.txt", "file_type": "text/plain", "file_size": 11542, "creation_date": "2026-10-08", "last_modified_date": "2026-10-08"}, "hash": "134405a4e6aee25d8c17108ec8a4423f161296228fd4f6e511be1e075a16dffb", "class_name": "RelatedNodeInfo"}, "2": {"node_id": "b2d45ebe-122b-44b3-9242-7f944e084506", "node_type": "1", "metadata": {"file_path": "C:\\Users\\g'y'w'y'w\\medical_rag\\knowledge\\\u667a\u6167\u533b\u7597RAG\u5b9e\u9a8c\u77e5\u8bc6\u5e93_30\u9898\u8986\u76d6\u7248.txt", "file_name": "\u667a\u6167\u533b\u7597RAG\u5b9e\u9a8c\u77e5\u8bc6\u5e93_30\u9898\u8986\u76d6\u7248.txt", "file_type": "text/plain", "file_size": 11542, "creation_date": "2026-10-08", "last_modified_date": "2026-10-08"}, "hash": "1bd726f8e98d313c8f65995fafd86e18960de9665970d1c62da2b170a22a85c8", "class_name": "RelatedNodeInfo"}, "3": {"node_id": "cf4a1798-ec3f-4777-b4e0-3a433c9fe63f", "node_type": "1", "metadata": {}, "hash": "093886ff422909662a67d945a594ecf665a6e3254610b0410efc72b3b34974e6", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "World Health Organization. Hypertension. 2025-09-25.\r\n2. \u4e2d\u56fd\u9ad8\u8840\u538b\u9632\u6cbb\u6307\u5357\u4fee\u8ba2\u59d4\u5458\u4f1a\u7b49. \u4e2d\u56fd\u9ad8\u8840\u538b\u9632\u6cbb\u6307\u5357\uff082024\u5e74\u4fee\u8ba2\u7248\uff09. \u4e2d\u534e\u9ad8\u8840\u538b\u6742\u5fd7\uff08\u4e2d\u82f1\u6587\uff09, 2024, 32(07):603-700. DOI:10.16439/j.issn.1673-7245.2024.07.002.\r\n\r\n==============================\r\n\u4e8c\u30012\u578b\u7cd6\u5c3f\u75c5\r\n==============================\r\n\u6838\u5fc3\u77e5\u8bc6\uff1a\r\n\u7cd6\u5c3f\u75c5\u662f\u4e00\u79cd\u4ee5\u8840\u7cd6\u8c03\u8282\u5f02\u5e38\u4e3a\u4e3b\u8981\u7279\u5f81\u7684\u6162\u6027\u4ee3\u8c22\u6027\u75be\u75c5\u30022\u578b\u7cd6\u5c3f\u75c5\u901a\u5e38\u4e0e\u80f0\u5c9b\u7d20\u62b5\u6297\u4ee5\u53ca\u80f0\u5c9b\u7d20\u5206\u6ccc\u80fd\u529b\u9010\u6e10\u4e0d\u8db3\u6709\u5173\u3002\r\n\u5e38\u89c1\u76f8\u5173\u5371\u9669\u56e0\u7d20\u5305\u62ec\u8d85\u91cd\u6216\u80a5\u80d6\u3001\u8eab\u4f53\u6d3b\u52a8\u4e0d\u8db3\u3001\u9057\u4f20\u56e0\u7d20\u3001\u5e74\u9f84\u589e\u957f\u4ee5\u53ca\u4e0d\u5065\u5eb7\u751f\u6d3b\u65b9\u5f0f\u7b49\u3002\r\n2\u578b\u7cd6\u5c3f\u75c5\u53ef\u901a\u8fc7\u5065\u5eb7\u996e\u98df\u3001\u89c4\u5f8b\u8eab\u4f53\u6d3b\u52a8\u3001\u4fdd\u6301\u9002\u5b9c\u4f53\u91cd\u7b49\u65b9\u5f0f\u964d\u4f4e\u53d1\u751f\u98ce\u9669\uff1b\u5df2\u7ecf\u60a3\u75c5\u7684\u4eba\u9700\u8981\u6839\u636e\u4e13\u4e1a\u4eba\u5458\u5efa\u8bae\u8fdb\u884c\u8840\u7cd6\u7ba1\u7406\u3001\u751f\u6d3b\u65b9\u5f0f\u7ba1\u7406\u3001\u5fc5\u8981\u7684\u836f\u7269\u6cbb\u7597\u4ee5\u53ca\u5e76\u53d1\u75c7\u7b5b\u67e5\u3002\r\n\u957f\u671f\u8840\u7cd6\u63a7\u5236\u4e0d\u4f73\u53ef\u635f\u5bb3\u5fc3\u8840\u7ba1\u3001\u773c\u3001\u80be\u810f\u548c\u795e\u7ecf\u7b49\u7cfb\u7edf\u3002\r\n\r\n\u6765\u6e90\uff1a\r\n1. World Health Organization. Diabetes. 2024-11-14.\r\n2. World Health Organization. Diabetes Q&A. 2026-09-01.\r\n\r\n==============================\r\n\u4e09\u3001\u51a0\u5fc3\u75c5\u4e0e\u52a8\u8109\u7ca5\u6837\u786c\u5316\r\n==============================\r\n\u6838\u5fc3\u77e5\u8bc6\uff1a\r\n\u51a0\u5fc3\u75c5\u662f\u51a0\u72b6\u52a8\u8109\u76f8\u5173\u75be\u75c5\u7684\u91cd\u8981\u7c7b\u578b\uff0c\u51a0\u72b6\u52a8\u8109\u7ca5\u6837\u786c\u5316\u6591\u5757\u5f62\u6210\u548c\u8fdb\u5c55\u53ef\u5bfc\u81f4\u8840\u7ba1\u72ed\u7a84\uff0c\u5f71\u54cd\u5fc3\u808c\u4f9b\u8840\u3002\r\n\u52a8\u8109\u7ca5\u6837\u786c\u5316\u4e0e\u8840\u8102\u5f02\u5e38\u3001\u5438\u70df\u3001\u9ad8\u8840\u538b\u3001\u7cd6\u4ee3\u8c22\u5f02\u5e38\u3001\u80a5\u80d6\u3001\u7f3a\u4e4f\u8eab\u4f53\u6d3b\u52a8\u7b49\u591a\u79cd\u56e0\u7d20\u76f8\u5173\u3002\r\n\u80f8\u75db\u7b49\u75c7\u72b6\u4e0d\u80fd\u5355\u72ec\u7528\u4e8e\u786e\u5b9a\u201c\u5c31\u662f\u51a0\u5fc3\u75c5\u201d\u3002\u65b0\u53d1\u3001\u660e\u663e\u6216\u6301\u7eed\u80f8\u75db\uff0c\u5c24\u5176\u4f34\u968f\u547c\u5438\u56f0\u96be\u3001\u51fa\u6c57\u3001\u6076\u5fc3\u3001\u6655\u53a5\u7b49\u60c5\u51b5\uff0c\u5e94\u53ca\u65f6\u5bfb\u6c42\u533b\u7597\u5e2e\u52a9\u3002\r\n\u6025\u6027\u5fc3\u808c\u6897\u6b7b\u901a\u5e38\u4e0e\u51a0\u72b6