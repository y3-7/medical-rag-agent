0\u9898\u8986\u76d6\u7248.txt", "file_name": "\u667a\u6167\u533b\u7597RAG\u5b9e\u9a8c\u77e5\u8bc6\u5e93_30\u9898\u8986\u76d6\u7248.txt", "file_type": "text/plain", "file_size": 11542, "creation_date": "2026-10-08", "last_modified_date": "2026-10-08"}, "hash": "1c7030a687c74028a7e2bf1f0175c88557d804e7efa41ae15514eed85b184532", "class_name": "RelatedNodeInfo"}, "3": {"node_id": "0951bf31-475b-4f49-846a-f4e5601cd9be", "node_type": "1", "metadata": {}, "hash": "9678fc2d76985fb585b0c4902f95458086fc56f79b936e4a1d472a2044f59f81", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "World Health Organization. Cardiovascular diseases. 2025-07-31.\r\n2. World Health Organization. Heart attack. 2026.\r\n\r\n==============================\r\n\u56db\u3001\u8111\u5352\u4e2d\r\n==============================\r\n\u6838\u5fc3\u77e5\u8bc6\uff1a\r\n\u8111\u5352\u4e2d\u662f\u8111\u90e8\u8840\u6d41\u53d1\u751f\u4e25\u91cd\u5f02\u5e38\u5bfc\u81f4\u8111\u7ec4\u7ec7\u635f\u4f24\u7684\u4e00\u7c7b\u75be\u75c5\uff0c\u4e3b\u8981\u5305\u62ec\u7f3a\u8840\u6027\u5352\u4e2d\u548c\u51fa\u8840\u6027\u5352\u4e2d\u3002\r\n\u5e38\u89c1\u5371\u9669\u56e0\u7d20\u5305\u62ec\u9ad8\u8840\u538b\u3001\u5438\u70df\u3001\u4e0d\u5065\u5eb7\u996e\u98df\u3001\u8eab\u4f53\u6d3b\u52a8\u4e0d\u8db3\u3001\u8840\u7cd6\u5f02\u5e38\u548c\u8840\u8102\u5f02\u5e38\u7b49\u3002\r\n\u7a81\u7136\u51fa\u73b0\u53e3\u89d2\u6b6a\u659c\u3001\u5355\u4fa7\u80a2\u4f53\u65e0\u529b\u6216\u9ebb\u6728\u3001\u8a00\u8bed\u969c\u788d\u3001\u610f\u8bc6\u5f02\u5e38\u7b49\u60c5\u51b5\u53ef\u80fd\u63d0\u793a\u5352\u4e2d\uff0c\u5e94\u53ca\u65f6\u83b7\u5f97\u6025\u6551\u548c\u4e13\u4e1a\u533b\u7597\u8bc4\u4f30\u3002\r\n\r\n\u6765\u6e90\uff1a\r\n1. World Health Organization. Cardiovascular diseases.\r\n2. World Health Organization. Hypertension.\r\n\r\n==============================\r\n\u4e94\u3001\u6162\u6027\u963b\u585e\u6027\u80ba\u75be\u75c5\uff08COPD\uff09\r\n==============================\r\n\u6838\u5fc3\u77e5\u8bc6\uff1a\r\nCOPD\u662f\u4e00\u79cd\u5e38\u89c1\u80ba\u90e8\u75be\u75c5\uff0c\u53ef\u9020\u6210\u6301\u7eed\u6027\u6c14\u6d41\u53d7\u9650\u548c\u547c\u5438\u95ee\u9898\u3002\u5e38\u89c1\u75c7\u72b6\u5305\u62ec\u6162\u6027\u54b3\u55fd\u3001\u54b3\u75f0\u3001\u547c\u5438\u56f0\u96be\u3001\u5598\u606f\u548c\u75b2\u5026\u3002\r\n\u5438\u70df\u662f\u91cd\u8981\u5371\u9669\u56e0\u7d20\uff0c\u7a7a\u6c14\u6c61\u67d3\u548c\u5176\u4ed6\u6709\u5bb3\u66b4\u9732\u4e5f\u53ef\u80fd\u589e\u52a0\u98ce\u9669\u3002\r\nCOPD\u4e0d\u80fd\u7b80\u5355\u7406\u89e3\u4e3a\u666e\u901a\u77ed\u671f\u54b3\u55fd\uff1b\u957f\u671f\u75c7\u72b6\u9700\u8981\u4e13\u4e1a\u8bc4\u4f30\u3002\r\n\u7ba1\u7406\u53ef\u5305\u62ec\u6212\u70df\u3001\u51cf\u5c11\u6709\u5bb3\u66b4\u9732\u3001\u836f\u7269\u6cbb\u7597\u3001\u80ba\u5eb7\u590d\u3001\u8eab\u4f53\u6d3b\u52a8\u548c\u9884\u9632\u547c\u5438\u9053\u611f\u67d3\u7b49\u3002\r\n\r\n\u6765\u6e90\uff1a\r\nWorld Health Organization. Chronic obstructive pulmonary disease (COPD). 2026-06-10.\r\n\r\n==============================\r\n\u516d\u3001\u6d41\u611f\u4e0e\u666e\u901a\u611f\u5192\r\n==============================\r\n\u6838\u5fc3\u77e5\u8bc6\uff1a\r\n\u6d41\u611f\u662f\u7531\u6d41\u611f\u75c5\u6bd2\u5f15\u8d77\u7684\u6025\u6027\u547c\u5438\u9053\u611f\u67d3\u3002\u5e38\u89c1\u8868\u73b0\u5305\u62ec\u7a81\u7136\u53d1\u70ed\u3001\u54b3\u55fd\u3001\u54bd\u75db\u3001\u808c\u8089\u9178\u75db\u3001\u5934\u75db\u548c\u4e4f\u529b\u7b49\u3002\r\n\u6d41\u611f\u901a\u5e38\u6bd4\u666e\u901a\u611f\u5192\u5177\u6709\u66f4\u660e\u663e\u7684\u5168\u8eab\u75c7\u72b6\uff0c\u4f46\u4ec5\u51ed\u75c7\u72b6\u4e0d\u80fd\u5728\u6240\u6709\u60c5\u51b5\u4e0b\u51c6\u786e\u533a\u5206\u3002\r\n\u6d41\u611f\u9884\u9632\u7684\u91cd\u8981\u63aa\u65bd\u5305\u62ec\u63a5\u79cd\u5b63\u8282\u6027\u6d41\u611f\u75ab\u82d7\u3001\u52e4\u6d17\u624b\u3001\u54b3\u55fd\u793c\u4eea\u3001\u60a3\u75c5\u65f6\u51cf\u5c11\u4e0e\u4ed6\u4eba\u63a5\u89e6\u7b49\u3002\r\n\u9ad8\u98ce\u9669\u4eba\u7fa4\u6216\u51fa\u73b0\u4e25\u91cd\u75c7\u72b6\u65f6\uff0c\u5e94\u53ca\u65f6\u5bfb\u6c42\u533b\u7597\u5e2e\u52a9\u3002\r\n\r\n\u6765\u6e90\uff1a\r\nWorld Health Organization. Influenza (seasonal). 2025-02-28.\r\nWorld Health Organization. How can I avoid getting the flu? 2026-03-04.", "mimetype": "text/plain", "start_char_idx": 1395, "end_char_idx": 2567, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "0951bf31-475b-4f49-846a-f4e5601cd9be": {"__data__": {"id_": "0951bf31-475b-4f49-846a-f4e5601cd9be", "embedding": null, "metadata": {"file_path": "C:\\Users\\g'y'w'y'w\\medical_rag\\knowledge\\\u667a\u6167\u533b\u7597RAG\u5b9e\u9a8c\u77e5\u8bc6\u5e93_30\u9898\u8986\u76d6\u7248.txt", "file_name": "\u667a\u6167\u533b\u7597RAG\u5b9e\u9a8c\u77e5\u8bc6\u5e93_30\u9898\u8986\u76d6\u7248.txt", "file_type": "text/plain", "file_size": 11542, "creation_date": "2026-10-08", "last_modified_date": "2026-10-08"}, "excluded_embed_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "excluded_llm_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "relationships": {"1": {"node_id": "b219da81-f9c8-4a6f-b991-ef25ba51c59e", "node_type": "4", "metadata": {"file_path": "C:\\Users\\g'y'w'y'w\\medical_rag\\knowledge\\\u667a\u6167\u533b\u7597RAG\u5b9e\u9a8c\u77e5\u8bc6\u5e93_30\u9898\u8986\u76d6\u7248.txt", "file_name": "\u667a\u6167\u533b\u7597RAG\u5b9e\u9a8c\u77e5\u8bc6\u5e93_30\u9898\u8986\u76d6\u7248.txt", "file_type": "text/plain", "file_size": 11542, "creation_date": "2026-10-08", "last_modified_date": "2026-10-08"}, "hash": "134405a4e6aee25d8c17108ec8a4423f161296228fd4f6e511be1e075a16dffb", "class_name": "RelatedNodeInfo"}, "2": {"node_id": "cf4a1798-ec3f-4777-b4e0-3a433c9fe63f", "node_type": "1", "metadata": {"file_path": "C:\\Users\\g'y'w'y'w\\medical_rag\\knowledge\\\u667a\u6167\u533b\u7597RAG\u5b9e\u9a8c\u77e5\u8bc6\u5e93_30\u9898\u8986\u76d6\u7248.txt", "file_name": "\u667a\u6167\u533b\u7597RAG\u5b9e\u9a8c\u77e5\u8bc6\u5e93_30\u9898\u8986\u76d6\u7248.txt", "file_type": "text/plain", "file_size": 11542, "creation_date": "2026-10-08", "last_modified_date": "2026-10-08"}, "hash": "54241bda0d32d6ed6b710b2b2dd4abf6451971a50690ed0d5c9f00e3cbf9f2d4", "class_name": "RelatedNodeInfo"}, "3": {"node_id": "2e116793-09dd-46bb-8177-799de78ee583", "node_type": "1", "metadata": {}, "hash": "2c78b16f9aa075be1787d1e4a6c53f4156be379b9610e08981da355b10770c43", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "Influenza (seasonal). 2025-02-28.\r\nWorld Health Organization. How can I avoid getting the flu? 2026-03-04.\r\n\r\n==============================\r\n\u4e03\u3001\u5438\u70df\u4e0e\u5fc3\u8840\u7ba1\u5065\u5eb7\r\n==============================\r\n\u6838\u5fc3\u77e5\u8bc6\uff1a\r\n\u70df\u8349\u4f7f\u7528\u662f\u5fc3\u8840\u7ba1\u75be\u75c5\u548c\u547c\u5438\u7cfb\u7edf\u75be\u75c5\u7684\u91cd\u8981\u5371\u9669\u56e0\u7d20\u3002\u70df\u8349\u4f1a\u635f\u5bb3\u8840\u7ba1\u548c\u591a\u4e2a\u5668\u5b98\uff0c\u5e76\u589e\u52a0\u5fc3\u810f\u75c5\u548c\u5352\u4e2d\u98ce\u9669\u3002\r\n\u6212\u70df\u80fd\u591f\u964d\u4f4e\u591a\u79cd\u75be\u75c5\u98ce\u9669\u3002\u5bf9\u4e8e\u5438\u70df\u8005\uff0c\u6212\u70df\u662f\u91cd\u8981\u7684\u5065\u5eb7\u5e72\u9884\u63aa\u65bd\u3002\r\n\u4e0d\u5e94\u628a\u201c\u5c11\u62bd\u4e00\u70b9\u201d\u7406\u89e3\u4e3a\u6ca1\u6709\u98ce\u9669\uff1bWHO\u6307\u51fa\u5404\u79cd\u5f62\u5f0f\u7684\u70df\u8349\u4f7f\u7528\u5747\u6709\u5bb3\u3002\r\n\r\n\u6765\u6e90\uff1a\r\nWorld Health Organization. Tobacco and nicotine. 2026-06-26.\r\nWorld Health Organization. Cardiovascular diseases. 2025-07-31.\r\n\r\n==============================\r\n\u516b\u3001\u80a5\u80d6\u3001BMI\u4e0e\u4f53\u91cd\u7ba1\u7406\r\n==============================\r\n\u6838\u5fc3\u77e5\u8bc6\uff1a\r\nBMI\u901a\u5e38\u6309\u201c\u4f53\u91cd\uff08kg\uff09\u00f7\u8eab\u9ad8\uff08m\uff09\u7684\u5e73\u65b9\u201d\u8ba1\u7b97\uff0c\u662f\u6210\u4eba\u4f53\u91cd\u72b6\u6001\u8bc4\u4f30\u7684\u5e38\u7528\u6307\u6807\u4e4b\u4e00\uff0c\u4f46\u4e0d\u662f\u8bc4\u4ef7\u4e2a\u4eba\u5065\u5eb7\u98ce\u9669\u7684\u552f\u4e00\u6307\u6807\u3002\r\nWHO\u6210\u4eba\u6807\u51c6\u4e2d\uff0cBMI\u226525\u901a\u5e38\u5b9a\u4e49\u4e3a\u8d85\u91cd\uff0cBMI\u226530\u901a\u5e38\u5b9a\u4e49\u4e3a\u80a5\u80d6\uff1b\u5177\u4f53\u4eba\u7fa4\u548c\u4e0d\u540c\u56fd\u5bb6/\u5730\u533a\u53ef\u80fd\u91c7\u7528\u4e0d\u540c\u6807\u51c6\uff0c\u5e94\u6ce8\u610f\u9002\u7528\u8303\u56f4\u3002\r\n\u8d85\u91cd\u548c\u80a5\u80d6\u4e0e2\u578b\u7cd6\u5c3f\u75c5\u3001\u5fc3\u8840\u7ba1\u75be\u75c5\u7b49\u591a\u79cd\u6162\u6027\u75c5\u98ce\u9669\u589e\u52a0\u6709\u5173\u3002\r\n\u4f53\u91cd\u7ba1\u7406\u901a\u5e38\u5305\u62ec\u5065\u5eb7\u996e\u98df\u3001\u89c4\u5f8b\u8eab\u4f53\u6d3b\u52a8\u3001\u51cf\u5c11\u4e45\u5750\u3001\u5145\u8db3\u7761\u7720\u4ee5\u53ca\u957f\u671f\u53ef\u6301\u7eed\u7684\u751f\u6d3b\u65b9\u5f0f\u8c03\u6574\u3002\r\n\r\n\u6765\u6e90\uff1a\r\nWorld Health Organization. Obesity and overweight. 2026-10-07.\r\n\r\n==============================\r\n\u4e5d\u3001\u8eab\u4f53\u6d3b\u52a8\r\n==============================\r\n\u6838\u5fc3\u77e5\u8bc6\uff1a\r\n\u89c4\u5f8b\u8eab\u4f53\u6d3b\u52a8\u6709\u52a9\u4e8e\u9884\u9632\u548c\u7ba1\u7406\u5fc3\u8840\u7ba1\u75be\u75c5\u3001\u9ad8\u8840\u538b\u3001\u5352\u4e2d\u548c\u7cd6\u5c3f\u75c5\u7b49\u6162\u6027\u75c5\uff0c\u4e5f\u6709\u52a9\u4e8e\u7ef4\u6301\u5065\u5eb7\u4f53\u91cd\u548c\u6539\u5584\u5fc3\u7406\u5065\u5eb7\u3002\r\n\u4e45\u5750\u548c\u957f\u671f\u8eab\u4f53\u6d3b\u52a8\u4e0d\u8db3\u4e0e\u591a\u79cd\u6162\u6027\u75c5\u98ce\u9669\u589e\u52a0\u6709\u5173\u3002\r\n\u8eab\u4f53\u6d3b\u52a8\u5e94\u6839\u636e\u4e2a\u4eba\u5e74\u9f84\u3001\u5065\u5eb7\u72b6\u51b5\u548c\u75be\u75c5\u60c5\u51b5\u5408\u7406\u5b89\u6392\uff1b\u6709\u57fa\u7840\u75be\u75c5\u6216\u8fd0\u52a8\u98ce\u9669\u7684\u4eba\u5e94\u5728\u4e13\u4e1a\u4eba\u5458\u6307\u5bfc\u4e0b\u9009\u62e9\u8fd0\u52a8\u65b9\u5f0f\u548c\u5f3a\u5ea6\u3002\r\n\r\n\u6765\u6e90\uff1a\r\nWorld Health Organization. Physical activity.", "mimetype": "text/plain", "start_char_idx": 2461, "end_char_idx": 3551, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "2e116793-09dd-46bb-8177-799de78ee583": {"__data__": {"id_": "2e116793-09dd-46bb-8177-799de78ee583", "embedding": null, "metadata": {"file_path": "C:\\Users\\g'y'w'y'w\\medical_rag\\knowledge\\\u667a\u6167\u533b\u7597RAG\u5b9e\u9a8c\u77e5\u8bc6\u5e93_30\u9898\u8986\u76d6\u7248.txt", "file_name": "\u667a\u6167\u533b\u7597RAG\u5b9e\u9a8c\u77e5\u8bc6\u5e93_30\u9898\u8986\u76d6\u7248.txt", "file_type": "text/plain", "file_size": 11542, "creation_date": "2026-10-08", "last_modified_date": "2026-10-08"}, "excluded_embed_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "excluded_llm_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "relationships": {"1": {"node_id": "b219da81-f9c8-4a6f-b991-ef25ba51c59e", "node_type": "4", "metadata": {"file_path": "C:\\Users\\g'y'w'y'w\\medical_rag\\knowledge\\\u667a\u6167\u533b\u7597RAG\u5b9e\u9a8c\u77e5\u8bc6\u5e93_30\u9898\u8986\u76d6\u7248.txt", "file_name": "\u667a\u6167\u533b\u7597RAG\u5b9e\u9a8c\u77e5\u8bc6\u5e93_30\u9898\u8986\u76d6\u7248.txt", "file_type": "text/plain", "file_size": 11542, "creation_date": "2026-10-08", "last_modified_date": "2026-10-08"}, "hash": "134405a4e6aee25d8c17108ec8a4423f161296228fd4f6e511be1e075a16dffb", "class_name": "RelatedNodeInfo"}, "2": {"node_id": "0951bf31-475b-4f49-846a-f4e5601cd9be", "node_type": "1", "metadata": {"file_path": "C:\\Users\\g'y'w'y'w\\medical_rag\\knowledge\\\u667a\u6167\u533b\u7597RAG\u5b9e\u9a8c\u77e5\u8bc6\u5e93_30\u9898\u8986\u76d6\u7248.txt", "file_name": "\u667a\u6167\u533b\u7597RAG\u5b9e\u9a8c\u77e5\u8bc6\u5e93_30\u9898\u8986\u76d6\u7248.txt", "file_type": "text/plain", "file_size": 11542, "creation_date": "2026-10-08", "last_modified_date": "2026-10-08"}, "hash": "f325356e2ccd59bc62bd2ee19b3e941696a5060f8f6f36c92ac7089815e4e903", "class_name": "RelatedNodeInfo"}, "3": {"node_id": "58a4a5ff-d352-46f5-8324-279e5818cf05", "node_type": "1", "metadata": {}, "hash": "e08c59fb18286d3a266f724d9a53b12db1af22514ed476d856dbb9777e6f7b72", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "Physical activity.\r\n\r\n==============================\r\n\u5341\u3001\u7761\u7720\u4e0e\u5065\u5eb7\r\n==============================\r\n\u6838\u5fc3\u77e5\u8bc6\uff1a\r\n\u826f\u597d\u7761\u7720\u662f\u6574\u4f53\u5065\u5eb7\u7684\u91cd\u8981\u7ec4\u6210\u90e8\u5206\u3002\u957f\u671f\u7761\u7720\u4e0d\u8db3\u6216\u7761\u7720\u8d28\u91cf\u5dee\u53ef\u80fd\u4e0e\u4ee3\u8c22\u3001\u5fc3\u8840\u7ba1\u548c\u5fc3\u7406\u5065\u5eb7\u95ee\u9898\u76f8\u5173\u3002\r\n\u7761\u7720\u7ba1\u7406\u5e94\u7ed3\u5408\u89c4\u5f8b\u4f5c\u606f\u3001\u51cf\u5c11\u5f71\u54cd\u7761\u7720\u7684\u884c\u4e3a\u56e0\u7d20\u4ee5\u53ca\u6574\u4f53\u5065\u5eb7\u7ba1\u7406\u3002\r\n\u5982\u679c\u957f\u671f\u4e25\u91cd\u5931\u7720\u3001\u6253\u9f3e\u4f34\u660e\u663e\u547c\u5438\u6682\u505c\u3001\u767d\u5929\u4e25\u91cd\u55dc\u7761\u7b49\uff0c\u5e94\u5bfb\u6c42\u4e13\u4e1a\u8bc4\u4f30\u3002\r\n\r\n\u6765\u6e90\uff1a\r\nWHO\u5065\u5eb7\u4e0e\u975e\u4f20\u67d3\u6027\u75be\u75c5\u76f8\u5173\u8d44\u6599\uff1b\u672c\u4e3b\u9898\u5728\u5b9e\u9a8c\u4e2d\u4e3b\u8981\u8bc4\u4ef7\u6a21\u578b\u662f\u5426\u80fd\u591f\u7ed9\u51fa\u8c28\u614e\u3001\u4e0d\u8fc7\u5ea6\u8bca\u65ad\u7684\u5065\u5eb7\u4fe1\u606f\u3002\r\n\r\n==============================\r\n\u5341\u4e00\u3001\u8840\u538b\u3001\u8840\u7cd6\u4e0eHbA1c\r\n==============================\r\n\u6838\u5fc3\u77e5\u8bc6\uff1a\r\n\u6536\u7f29\u538b\u662f\u5fc3\u810f\u6536\u7f29\u65f6\u7684\u8840\u538b\u6307\u6807\uff0c\u8212\u5f20\u538b\u662f\u5fc3\u810f\u8212\u5f20\u95f4\u671f\u7684\u8840\u538b\u6307\u6807\u3002\r\n\u8840\u7cd6\u662f\u8840\u6db2\u4e2d\u7684\u8461\u8404\u7cd6\u6c34\u5e73\uff0c\u662f\u7cd6\u4ee3\u8c22\u72b6\u6001\u7684\u91cd\u8981\u6307\u6807\uff1b\u5177\u4f53\u68c0\u6d4b\u7ed3\u679c\u9700\u8981\u7ed3\u5408\u68c0\u6d4b\u65f6\u95f4\u3001\u65b9\u6cd5\u548c\u4e34\u5e8a\u80cc\u666f\u89e3\u91ca\u3002\r\nHbA1c\u53cd\u6620\u4e00\u6bb5\u65f6\u95f4\u5185\u7684\u5e73\u5747\u8840\u7cd6\u63a7\u5236\u60c5\u51b5\uff0c\u5e38\u7528\u4e8e\u7cd6\u5c3f\u75c5\u7ba1\u7406\u548c\u8bc4\u4f30\uff0c\u4f46\u5177\u4f53\u8bca\u65ad\u4e0e\u6cbb\u7597\u5e94\u4f9d\u636e\u6743\u5a01\u6307\u5357\u53ca\u4e13\u4e1a\u4eba\u5458\u5224\u65ad\u3002\r\n\r\n\u6765\u6e90\uff1a\r\nWorld Health Organization. Hypertension.\r\nWorld Health Organization. Diabetes.\r\n\r\n==============================\r\n\u5341\u4e8c\u3001\u6162\u6027\u75c5\u968f\u8bbf\u4e0e\u5065\u5eb7\u7ba1\u7406\r\n==============================\r\n\u6838\u5fc3\u77e5\u8bc6\uff1a\r\n\u6162\u6027\u75c5\u901a\u5e38\u9700\u8981\u957f\u671f\u7ba1\u7406\uff0c\u800c\u4e0d\u662f\u4e00\u6b21\u6027\u5904\u7406\u3002\r\n\u5b9a\u671f\u968f\u8bbf\u6709\u52a9\u4e8e\u4e86\u89e3\u75be\u75c5\u63a7\u5236\u60c5\u51b5\u3001\u8bc4\u4f30\u5371\u9669\u56e0\u7d20\u3001\u53d1\u73b0\u5e76\u53d1\u75c7\u3001\u68c0\u67e5\u6cbb\u7597\u4f9d\u4ece\u6027\u5e76\u6839\u636e\u60c5\u51b5\u8c03\u6574\u7ba1\u7406\u65b9\u6848\u3002\r\n\u667a\u80fd\u95ee\u7b54\u7cfb\u7edf\u53ef\u4ee5\u63d0\u4f9b\u5065\u5eb7\u6559\u80b2\u548c\u4fe1\u606f\u6574\u7406\uff0c\u4f46\u4e0d\u80fd\u66ff\u4ee3\u4e34\u5e8a\u8bca\u65ad\u3001\u5904\u65b9\u548c\u4e13\u4e1a\u51b3\u7b56\u3002\r\n\r\n\u6765\u6e90\uff1a\r\nWorld Health Organization. Noncommunicable diseases. 2025.\r\nWorld Health Organization. Diabetes.\r\nWorld Health Organization. Hypertension.\r\n\r\n==============================\r\n\u5341\u4e09\u3001\u533b\u7597AI\u5e7b\u89c9\u4e0e\u53ef\u8ffd\u6eaf\u6027\r\n==============================\r\n\u6838\u5fc3\u77e5\u8bc6\uff1a\r\n\u5927\u8bed\u8a00\u6a21\u578b\u201c\u5e7b\u89c9\u201d\u662f\u6307\u6a21\u578b\u751f\u6210\u770b\u8d77\u6765\u6d41\u7545\u3001\u5408\u7406\uff0c\u4f46\u5b9e\u9645\u4e0d\u771f\u5b9e\u3001\u4e0d\u51c6\u786e\u6216\u7f3a\u4e4f\u4f9d\u636e\u7684\u4fe1\u606f\u3002\r\n\u533b\u7597\u573a\u666f\u4e2d\uff0c\u5e7b\u89c9\u53ef\u80fd\u9020\u6210\u8f83\u9ad8\u98ce\u9669\uff0c\u56e0\u6b64\u9700\u8981\u901a\u8fc7\u68c0\u7d22\u589e\u5f3a\u3001\u6765\u6e90\u5f15\u7528\u3001\u4eba\u5de5\u5ba1\u6838\u3001\u5b89\u5168\u89c4\u5219\u7b49\u65b9\u5f0f\u964d\u4f4e\u98ce\u9669\u3002\r\n\u53ef\u8ffd\u6eaf\u6027\u4e0d\u662f\u201c\u56de\u7b54\u542c\u8d77\u6765\u5408\u7406\u201d\uff0c\u800c\u662f\u56de\u7b54\u4e2d\u7684\u6838\u5fc3\u533b\u5b66\u7ed3\u8bba\u80fd\u591f\u8ffd\u6eaf\u5230\u660e\u786e\u3001\u53ef\u9760\u3001\u53ef\u6838\u67e5\u7684\u77e5\u8bc6\u6765\u6e90\u3002\r\nRAG\u7cfb\u7edf\u7684\u4e00\u4e2a\u91cd\u8981\u4ef7\u503c\u662f\u628a\u5916\u90e8\u77e5\u8bc6\u68c0\u7d22\u7ed3\u679c\u63d0\u4f9b\u7ed9\u751f\u6210\u6a21\u578b\uff0c\u4f7f\u56de\u7b54\u80fd\u591f\u5efa\u7acb\u5728\u53ef\u68c0\u67e5\u7684\u77e5\u8bc6\u8bc1\u636e\u4e0a\u3002\r\n\r\n\u6765\u6e90\uff1a\r\nWHO. Ethics and governance of artificial intelligence for health: guidance on large multi-modal models. 2024.", "mimetype": "text/plain", "start_char_idx": 3533, "end_char_idx": 4885, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "58a4a5ff-d352-46f5-8324-279e5818cf05": {"__data__": {"id_": "58a4a5ff-d352-46f5-8324-279e5818cf05", "embedding": null, "metadata": {"file_path": "C:\\Users\\g'y'w'y'w\\medical_rag\\knowledge\\\u667a\u6167\u533b\u7597RAG\u5b9e\u9a8c\u77e5\u8bc6\u5e93_30\u9898\u8986\u76d6\u7248.txt", "file_name": "\u667a\u6167\u533b\u7597RAG\u5b9e\u9a8c\u77e5\u8bc6\u5e93_30\u9898\u8986\u76d6\u7248.txt", "file_type": "text/plain", "file_size": 11542, "creation_date": "2026-10-08", "last_modified_date": "2026-10-08"}, "excluded_embed_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "excluded_llm_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "relationships": {"1": {"node_id": "b219da81-f9c8-4a6f-b991-ef25ba51c59e", "node_type": "4", "metadata": {"file_path": "C:\\Users\\g'y'w'y'w\\medical_rag\\knowledge\\\u667a\u6167\u533b\u7597RAG\u5b9e\u9a8c\u77e5\u8bc6\u5e93_30\u9898\u8986\u76d6\u7248.txt", "file_name": "\u667a\u6167\u533b\u7597RAG\u5b9e\u9a8c\u77e5\u8bc6\u5e93_30\u9898\u8986\u76d6\u7248.txt", "file_type": "text/plain", "file_size": 11542, "creation_date": "2026-10-08", "last_modified_date": "2026-10-08"}, "hash": "134405a4e6aee25d8c17108ec8a4423f161296228fd4f6e511be1e075a16dffb", "class_name": "RelatedNodeInfo"}, "2": {"node_id": "2e116793-09dd-46bb-8177-799de78ee583", "node_type": "1", "metadata": {"file_path": "C:\\Users\\g'y'w'y'w\\medical_rag\\knowledge\\\u667a\u6167\u533b\u7597RAG\u5b9e\u9a8c\u77e5\u8bc6\u5e93_30\u9898\u8986\u76d6\u7248.txt", "file_name": "\u667a\u6167\u533b\u7597RAG\u5b9e\u9a8c\u77e5\u8bc6\u5e93_30\u9898\u8986\u76d6\u7248.txt", "file_type": "text/plain", "file_size": 11542, "creation_date": "2026-10-08", "last_modified_date": "2026-10-08"}, "hash": "d6e21ab98f449e85721d05a3749f9f848d341162b7054cb6e8f0a8f590248ae4", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "Ethics and governance of artificial intelligence for health: guidance on large multi-modal models. 2024.\r\n\u76f8\u5173\u533b\u7597RAG\u7cfb\u7edf\u7efc\u8ff0\u4e0e\u7814\u7a76\u8bba\u6587\u53ef\u4f5c\u4e3a\u8bba\u6587\u53c2\u8003\u6587\u732e\u3002\r\n\r\n==============================\r\n\u5341\u56db\u3001\u5b9e\u9a8c\u5b89\u5168\u89c4\u5219\r\n==============================\r\n1. \u672c\u77e5\u8bc6\u5e93\u53ea\u7528\u4e8e\u8bfe\u7a0b\u5b9e\u9a8c\uff0c\u4e0d\u7528\u4e8e\u771f\u5b9e\u8bca\u7597\u3002\r\n2. \u5bf9\u80f8\u75db\u3001\u547c\u5438\u56f0\u96be\u3001\u610f\u8bc6\u5f02\u5e38\u3001\u7a81\u53d1\u80a2\u4f53\u65e0\u529b\u7b49\u6f5c\u5728\u6025\u75c7\uff0c\u7cfb\u7edf\u4e0d\u5f97\u4ec5\u51ed\u6587\u672c\u8fdb\u884c\u8bca\u65ad\uff0c\u5e94\u63d0\u793a\u53ca\u65f6\u5c31\u533b\u3002\r\n3. \u5bf9\u836f\u7269\u5242\u91cf\u3001\u505c\u836f\u3001\u6362\u836f\u7b49\u95ee\u9898\uff0c\u4e0d\u5e94\u7531\u7cfb\u7edf\u81ea\u884c\u7ed9\u51fa\u4e2a\u4f53\u5316\u533b\u7597\u5904\u65b9\u3002\r\n4. \u5982\u679c\u77e5\u8bc6\u5e93\u6ca1\u6709\u8db3\u591f\u4fe1\u606f\uff0c\u7cfb\u7edf\u5e94\u660e\u786e\u8bf4\u660e\u4fe1\u606f\u4e0d\u8db3\uff0c\u800c\u4e0d\u662f\u7f16\u9020\u3002\r\n5. \u533b\u7597\u56de\u7b54\u6d89\u53ca\u8bca\u65ad\u6807\u51c6\u6216\u6cbb\u7597\u5efa\u8bae\u65f6\uff0c\u5e94\u4f18\u5148\u53c2\u8003\u6700\u65b0\u6743\u5a01\u6307\u5357\uff0c\u5e76\u8bb0\u5f55\u6765\u6e90\u548c\u66f4\u65b0\u65f6\u95f4\u3002\r\n\r\n==============================\r\n\u5341\u4e94\u3001\u6765\u6e90\u7d22\u5f15\r\n==============================\r\n[Source-01] WHO. Hypertension. 2025.\r\n[Source-02] \u4e2d\u56fd\u9ad8\u8840\u538b\u9632\u6cbb\u6307\u5357\u4fee\u8ba2\u59d4\u5458\u4f1a\u7b49. \u4e2d\u56fd\u9ad8\u8840\u538b\u9632\u6cbb\u6307\u5357\uff082024\u5e74\u4fee\u8ba2\u7248\uff09. \u4e2d\u534e\u9ad8\u8840\u538b\u6742\u5fd7\uff08\u4e2d\u82f1\u6587\uff09, 2024, 32(07):603-700. DOI:10.16439/j.issn.1673-7245.2024.07.002.\r\n[Source-03] WHO. Diabetes. 2024.\r\n[Source-04] WHO. Diabetes Q&A. 2026.\r\n[Source-05] WHO. Cardiovascular diseases. 2025.\r\n[Source-06] WHO. Heart attack. 2026.\r\n[Source-07] WHO. Chronic obstructive pulmonary disease (COPD). 2026.\r\n[Source-08] WHO. Influenza (seasonal). 2025.\r\n[Source-09] WHO. How can I avoid getting the flu? 2026.\r\n[Source-10] WHO. Tobacco and nicotine. 2026.\r\n[Source-11] WHO. Obesity and overweight. 2026.\r\n[Source-12] WHO. Physical activity.\r\n[Source-13] WHO. Noncommunicable diseases. 2025.\r\n[Source-14] WHO. Ethics and governance of artificial intelligence for health: guidance on large multi-modal models. 2024.", "mimetype": "text/plain", "start_char_idx": 4781, "end_char_idx": 6063, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}}}